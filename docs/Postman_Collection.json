		},
		{
			"name": "5. Đặt vé & Giữ ghế (Bookings)",
			"item": [
				{
					"name": "Tạo đơn giữ ghế 10 phút (Hold Booking)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"showtimeId\": 1,\n  \"seatIds\": [1, 2],\n  \"foods\": [\n    {\n      \"foodId\": 3,\n      \"quantity\": 1\n    }\n  ],\n  \"promotionCode\": \"WELCOME10\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/bookings/hold",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "bookings", "hold"]
						}
					}
				},
				{
					"name": "Xem tóm tắt đơn hàng & thời gian còn lại",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/bookings/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "bookings", "1"]
						}
					}
				},
				{
					"name": "Lịch sử đặt vé cá nhân",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/bookings/my-bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "bookings", "my-bookings"]
						}
					}
				}
			]
		},
		{
			"name": "6. Thanh toán (Payments)",
			"item": [
				{
					"name": "Tạo URL Thanh toán VNPAY Sandbox",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/payments/create?bookingId=1&method=VNPAY",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "payments", "create"],
							"query": [
								{
									"key": "bookingId",
									"value": "1"
								},
								{
									"key": "method",
									"value": "VNPAY"
								}
							]
						}
					}
				},
				{
					"name": "Thanh toán Tiền mặt / Chuyển khoản trực tiếp",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/payments/create?bookingId=1&method=CASH",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "payments", "create"],
							"query": [
								{
									"key": "bookingId",
									"value": "1"
								},
								{
									"key": "method",
									"value": "CASH"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "7. Quản trị viên (Admin)",
