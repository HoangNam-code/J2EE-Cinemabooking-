							"raw": "{\n  \"movieId\": 1,\n  \"roomId\": 1,\n  \"showDate\": \"2026-10-12\",\n  \"startTime\": \"20:00:00\",\n  \"price\": 100000.00,\n  \"format\": \"2D\"\n}"
						},
						"url": {
