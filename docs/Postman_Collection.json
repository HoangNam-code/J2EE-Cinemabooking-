							"path": ["api", "v1", "showtimes", "movie", "1"]
						}
					}
				},
				{
					"name": "Sơ đồ ghế + trạng thái FREE / HOLD / BOOKED",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/showtimes/1/seats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "showtimes", "1", "seats"]
