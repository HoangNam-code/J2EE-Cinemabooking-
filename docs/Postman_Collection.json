						"body": {
							"mode": "raw",
							"raw": "{\n  \"movieName\": \"Chiến Binh Không Gian\",\n  \"duration\": 135,\n  \"director\": \"Ridley Scott\",\n  \"actors\": \"Michael Fassbender, Sigourney Weaver\",\n  \"description\": \"Hành trình khám phá hành tinh bí ẩn ngoài dải ngân hà.\",\n  \"releaseDate\": \"2026-11-01\",\n  \"endDate\": \"2026-12-31\",\n  \"posterUrl\": \"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=600\",\n  \"trailerUrl\": \"https://youtube.com/\",\n  \"status\": \"COMING_SOON\",\n  \"categoryIds\": [1, 2]\n}"
						},
