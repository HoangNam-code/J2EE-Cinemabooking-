		{
			"name": "4. Menu Bắp Nước (Foods)",
			"item": [
				{
					"name": "Lấy danh mục Bắp Nước & Combo",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/foods",
